{
  "extends": "@tsconfig/node18/tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.spec.ts",
    "tests/**/*.ts",
    "tests/**/*.spec.ts",
    "src/api/swagger/index.tsx",
    "src/api/routes/v1/*.yaml"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#logger": ["src/shared/logging"],
      "#errors": ["src/shared/errors"],
      "@db": ["src/shared/db"],
      "@dbmodels/*": ["src/shared/db/models/*"],
      "#config": ["src/shared/config"],
      "src": ["src/*"]
    },
    "types": ["node", "jest"],
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true
  }
}
