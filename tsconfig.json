{
  "extends": "@tsconfig/node18/tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.spec.ts"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "src": ["./src/*"],
      "@logger": ["./src/shared/logging"]
    },
    "types": ["node", "jest"],
    "experimentalDecorators": true
  }
}
