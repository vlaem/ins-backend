{
  "name": "@vlaem/ins-backend",
  "version": "1.0.0",
  "description": "ins-backend",
  "main": "./dist/server.js",
  "scripts": {
    "lint": "eslint --ext .ts src",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest",
    "prepare": "husky install",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "migration-skeleton": "tsx tools/migration-skeleton.ts",
    "build": "pkgroll --sourcefile  --env.NODE_ENV=production"
  },
  "exports": {
    ".": "./dist/server.js",
    "./migrate": "./dist/migrate.js"
  },
  "imports": {
    "~errors": "./src/shared/errors/index.ts",
    "~logger": "./src/shared/logging/index.ts",
    "~config": "./src/config/index.ts",
    "~dbmodels": "./src/shared/db/models",
    "~": "./src"
  },
  "dependencies": {
    "@hono/node-server": "^1.1.0",
    "@hono/zod-validator": "^0.1.3",
    "@sequelize/core": "^7.0.0-alpha.27",
    "bcryptjs": "^2.4.3",
    "bottlejs": "^2.0.1",
    "dotenv": "^16.3.1",
    "firebase-admin": "^11.10.1",
    "hono": "^3.3.4",
    "hono-swagger-jsdoc": "^0.0.6",
    "jsonwebtoken": "^9.0.1",
    "luxon": "^3.3.0",
    "pg": "^8.11.1",
    "safe-stable-stringify": "^2.4.3",
    "uid-safe": "^2.1.5",
    "umzug": "^3.2.1",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/luxon": "^3.3.1",
    "@types/node": "^20.4.5",
    "@types/uid-safe": "^2.1.2",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.9.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.2",
    "jest-mock-extended": "^3.0.5",
    "pkgroll": "^1.11.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.1",
    "tsx": "^3.12.2",
    "typescript": "^5.1.6"
  }
}
